# Klipper For Android / klipper-android bridge
# Copy to:
#   /data/data/com.termux/files/home/printer_data/config/bridge.conf
# and replace <TOKEN> with the real token generated by the Android app.
# Never commit or publish the real token.

server=127.0.0.1
port=27831
token=<TOKEN>
log_interval=60
device=main,auto,250000,8,1,none,dtr+rts,/data/data/com.termux/files/usr/var/run/klipper-android/main
